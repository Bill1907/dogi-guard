# Supabase Configuration
# Get these from your Supabase Dashboard: https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase API Key - NEW FORMAT (2025)
# Use the new publishable key format (sb_publishable_...) 
# Legacy anon keys (starting with eyJ...) will be deprecated November 2025
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key_here

# Optional: Supabase Service Role Key (NEVER expose in client-side code)
# Only use this for server-side operations, Edge Functions, or secure environments
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_key_here

# Clerk Configuration  
# Get your publishable key from Clerk Dashboard: https://dashboard.clerk.dev
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# Google Places API Configuration
# Get your API key from Google Cloud Console: https://console.cloud.google.com
# 1. Enable Places API (New)
# 2. Create credentials (API Key)
# 3. Restrict the API key to Places API (New) and your app bundle/domain
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Authentication Setup:
# 1. Enable Authentication in your Supabase Dashboard
# 2. Configure email templates for confirmation/reset
# 3. Set site URL and redirect URLs for your app
# 4. Enable desired auth providers (Google, Apple, etc.)